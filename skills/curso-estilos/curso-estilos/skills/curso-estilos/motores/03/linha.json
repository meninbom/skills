 "falas": [
  {
   "id": "A1-03",
   "q": "NAR",
   "txt": "Ele nem virou a cabeça.",
   "t0": 3.08,
   "d": 1.7125
  },
  {
   "id": "A1-05",
   "q": "GEN",
   "txt": "Anomalia detectada. Iniciando processo de eliminação.",
   "t0": 7.2225,
   "d": 3.357142857142857
  },
  {
   "id": "A1-06",
   "q": "NICO",
   "txt": "Não! Minha mestra, não!",
   "t0": 10.959642857142857,
   "d": 1.4403225806451612
  },
  {
   "id": "A1-07",
   "q": "IARA",
   "txt": "Foge, Nico. Ele é forte demais. Por favor.",
   "t0": 12.729965437788017,
   "d": 2.7306451612903224
  },
  {
   "id": "A1-10",
   "q": "NICO",
   "txt": "Como assim? Ele não tem ponto fraco?",
   "t0": 21.44061059907834,
   "d": 2.408064516129032
  },
  {
   "id": "A1-12_1",
   "q": "NAR",
   "txt": "Ele não desviava da flecha. Desviava do barulho.",
   "t0": 25.948675115207376,
   "d": 2.65
  },
  {
   "id": "A1-12_2",
   "q": "NAR",
   "txt": "O estalo da corda chega seis vezes antes dela.",
   "t0": 28.778675115207374,
   "d": 2.9625
  },
  {
   "id": "A2-01",
   "q": "IARA",
   "txt": "Ele ouve igual bicho do mato. Mira embaixo!",
   "t0": 32.321175115207375,
   "d": 2.7306451612903224
  },
  {
   "id": "A2-03",
   "q": "NAR",
   "txt": "Só que aquilo não era bicho.",
   "t0": 41.681820276497696,
   "d": 2.025
  },
  {
   "id": "A2-06_1",
   "q": "NAR",
   "txt": "Mais um desses, e o Nico acordava na cápsula.",
   "t0": 51.986820276497696,
   "d": 2.9625
  },
  {
   "id": "A2-06_2",
   "q": "NAR",
   "txt": "E ela ficava ali, sozinha.",
   "t0": 55.129320276497694,
   "d": 1.7125
  },
  {
   "id": "A2-08_1",
   "q": "NAR",
   "txt": "Fazia meses que ele treinava com ela.",
   "t0": 59.67182027649769,
   "d": 2.3375
  },
  {
   "id": "A2-08_2",
   "q": "NAR",
   "txt": "Nunca tinha visto ela lutar.",
   "t0": 62.189320276497696,
   "d": 1.7125
  },
  {
   "id": "A2-11",
   "q": "GEN",
   "txt": "Eliminação em dez. Nove.",
   "t0": 84.18182027649769,
   "d": 2.6547619047619047
  },
  {
   "id": "A3-01_1",
   "q": "NAR",
   "txt": "O Nico olhou pra dentro daquela concha procurando um rosto.",
   "t0": 87.2665821812596,
   "d": 3.275
  },
  {
   "id": "A3-01_2",
   "q": "NAR",
   "txt": "Não tinha nada pra ler.",
   "t0": 90.72158218125959,
   "d": 1.7125
  },
  {
   "id": "A3-01_3",
   "q": "NAR",
   "txt": "E mesmo assim ele entendeu o que vinha.",
   "t0": 92.61408218125959,
   "d": 2.65
  },
  {
   "id": "A3-02_1",
   "q": "NICO",
   "txt": "Tu foi a única que acreditou em mim.",
   "t0": 95.7440821812596,
   "d": 2.7306451612903224
  },
  {
   "id": "A3-02_2",
   "q": "NICO",
   "txt": "NPC ou não, eu não vou te largar.",
   "t0": 98.65472734254992,
   "d": 2.7306451612903224
  },
  {
   "id": "A3-03",
   "q": "GEN",
   "txt": "Seis. Cinco.",
   "t0": 101.76537250384024,
   "d": 2.0023809523809524
  },
  {
   "id": "A3-04",
   "q": "NICO",
   "txt": "Então ela tem que chegar antes do barulho.",
   "t0": 104.0977534562212,
   "d": 2.7306451612903224
  },
  {
   "id": "A3-06",
   "q": "GEN",
   "txt": "Três. Dois.",
   "t0": 117.60839861751153,
   "d": 1.8023809523809522
  },
  {
   "id": "A3-07_1",
   "q": "NAR",
   "txt": "Ele não ouviu nada.",
   "t0": 121.71077956989248,
   "d": 1.4
  },
  {
   "id": "A3-07_2",
   "q": "NAR",
   "txt": "Sabe o estrondo de caça passando?",
   "t0": 124.31077956989249,
   "d": 2.025
  },
  {
   "id": "A3-07_3",
   "q": "NAR",
   "txt": "Não é o motor.",
   "t0": 126.51577956989249,
   "d": 1.4
  },
  {
   "id": "A3-07_4",
   "q": "NAR",
   "txt": "É o ar que ele empurrou, chegando todo de uma vez, atrasado.",
   "t0": 128.09577956989247,
   "d": 3.9
  },
  {
   "id": "A3-09",
   "q": "GEN",
   "txt": "Segunda anomalia detectada.",
   "t0": 136.4757795698925,
   "d": 1.8785714285714286
  },
  {
   "id": "A4-01",
   "q": "IARA",
   "txt": "De novo não.",
   "t0": 139.5543509984639,
   "d": 1.117741935483871
  },
  {
   "id": "A4-02_1",
   "q": "NAR",
   "txt": "E o Nico sentiu o peito.",
   "t0": 141.35209293394777,
   "d": 2.025
  },
  {
   "id": "A4-02_2",
   "q": "NAR",
   "txt": "Não o do jogo. O de verdade.",
   "t0": 143.55709293394776,
   "d": 2.3375
  },
  {
   "id": "A4-03_1",
   "q": "NAR",
   "txt": "O poder não era da flecha. Era dele.",
   "t0": 146.47459293394778,
   "d": 2.65
  },
  {
   "id": "A4-03_2",
   "q": "NAR",
   "txt": "E quem pagava era o corpo deitado na cápsula.",
   "t0": 149.30459293394776,
   "d": 2.9625
  },
  {
   "id": "A4-05",
   "q": "NAR",
   "txt": "Desconecta, ou fica?",
   "t0": 157.36709293394776,
   "d": 1.0875
  }
 ],
