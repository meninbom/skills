{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__claude-in-chrome__.*|mcp__Claude_Browser__.*|mcp__remote-devices__Claude_Browser__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["CAMINHO/DO/SEU/PROJETO/trava_pago.py", "pre"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__claude-in-chrome__.*|mcp__Claude_Browser__.*|mcp__remote-devices__Claude_Browser__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["CAMINHO/DO/SEU/PROJETO/trava_pago.py", "post"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
