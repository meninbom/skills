{
  "name": "anime-svg-em-dois",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Curta de anime em SVG + GSAP com a gramatica em dois. Render quadro a quadro com o Chrome do sistema.",
  "scripts": {
    "postinstall": "node lib/copiar_gsap.mjs",
    "demo": "node render.mjs --pagina index.html --video saida/demo.mp4 --ini 14 --fim 17 --esc 0.5",
    "folha": "node render.mjs --pagina index.html --quadros 2,5.5,9,12,15,16.1,18,22,24,27,28.5,29 --out saida/folha.jpg --esc 0.5",
    "filme": "node render.mjs --pagina index.html --video saida/fisgada_1080.mp4",
    "chuva": "node render.mjs --pagina chuva_lamina/index.html --video saida/chuva_lamina_1080.mp4"
  },
  "dependencies": {
    "puppeteer-core": "^23.11.1",
    "gsap": "3.14.2"
  }
}
